server:
  port: 8082

spring:
  application:
    name: authentication-service

  datasource:
    url: jdbc:postgresql://localhost:5432/authentication_db
    username: postgres
    password: CHANGE_ME
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  mail:
    host: smtp.gmail.com
    port: 587
    username: CHANGE_ME
    password: CHANGE_ME
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

jwt:
  secret: CHANGE_ME
  access-token-expiration: 1800000      # 30 minutes en ms
  refresh-token-expiration: 604800000   # 7 jours en ms

otp:
  expiration-minutes: 10
  max-attempts: 5
  resend-cooldown-seconds: 60

services:
  user-service:
    url: http://user-service:8083